{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with tests enabled",
      "generator": "Ninja",
      "binaryDir": "cmake-build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build without tests",
      "generator": "Ninja",
      "binaryDir": "cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Debug build with tests and coverage instrumentation",
      "generator": "Ninja",
      "binaryDir": "cmake-build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "ON",
        "BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "docs",
      "displayName": "Docs",
      "description": "Release build with docs enabled",
      "generator": "Ninja",
      "binaryDir": "cmake-build-docs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DOCS": "ON",
        "BUILD_TESTS": "OFF"
      }
    }
  ]
}
