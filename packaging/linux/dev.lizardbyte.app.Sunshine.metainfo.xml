<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@PROJECT_FQDN@</id>

  <name>SolarFlare</name>
  <summary>@PROJECT_BRIEF_DESCRIPTION@</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@PROJECT_LICENSE@</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <url type="homepage">@PROJECT_HOMEPAGE_URL@</url>
  <url type="bugtracker">https://github.com/vindeckyy/Solar-Flare/issues</url>
  <url type="faq">https://github.com/vindeckyy/Solar-Flare/blob/master/docs/troubleshooting.md</url>
  <url type="help">https://github.com/vindeckyy/Solar-Flare#readme</url>
  <url type="contact">https://github.com/vindeckyy/Solar-Flare/issues</url>

  <description>
    <p>@PROJECT_LONG_DESCRIPTION@</p>

    <p>NOTE: The inherited Flatpak target requires additional installation steps.</p>
    <p>
      <code>flatpak run --command=additional-install.sh @PROJECT_FQDN@</code>
    </p>
    <p>NOTE: SolarFlare uses a host-local self-signed certificate by default, so browsers may show a certificate warning.</p>
  </description>

  <releases>
    <release version="@PROJECT_VERSION@" date="@PROJECT_YEAR@-@PROJECT_MONTH@-@PROJECT_DAY@">
      <url>https://github.com/vindeckyy/Solar-Flare/releases/tag/v@PROJECT_VERSION@-solarflare</url>
      <description>
        <p>See the changelog on GitHub</p>
      </description>
    </release>
  </releases>

  <developer id="io.github.vindeckyy">
    <name>SolarFlare contributors</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/vindeckyy/Solar-Flare/master/docs/images/web-ui-home.png</image>
      <caption>SolarFlare Web UI</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.0">
    <content_attribute id="language-profanity">moderate</content_attribute>
    <content_attribute id="language-humor">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@PROJECT_FQDN@.desktop</launchable>
</component>
